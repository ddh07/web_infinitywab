# Infinity WAB - Production
# Copier vers .env puis: php artisan key:generate

APP_NAME="Infinity WAB"
APP_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_ENV=production
APP_DEBUG=false
# URL publique exacte (schéma + domaine). Les balises @vite utilisent asset() : en prod HTTPS,
# une valeur en http:// ou localhost casse le chargement des CSS derrière un proxy.
APP_URL=https://votre-domaine.com
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=infinity_wab
DB_USERNAME=infinity_wab
DB_PASSWORD=

# Mot de passe du compte admin créé par le seeder (database/seeders/UserSeeder.php).
# Si vide, un mot de passe aléatoire fort est généré et affiché une seule fois lors du seed.
ADMIN_SEED_PASSWORD=

# Google Tag Manager : identifiant du conteneur (format GTM-XXXXXXX), trouvable dans
# GTM > Admin > Installer Google Tag Manager. Laisser vide désactive complètement
# l'intégration (aucun script Google chargé).
GTM_CONTAINER_ID=

# Google Analytics Data API (GA4) : alimente les vraies statistiques de trafic dans
# l'admin (visiteurs, taux de rebond, durée de session...), à la place des estimations
# par défaut. Nécessite un compte de service Google Cloud avec le rôle "Lecteur" sur
# la propriété GA4 (Admin GA4 > Gestion des accès à la propriété), et l'API
# "Google Analytics Data API" activée dans Google Cloud Console.
# GA4_PROPERTY_ID : l'identifiant numérique de la propriété GA4 (ex: 123456789, PAS le G-XXXXXXX).
# GA4_CREDENTIALS_PATH : chemin absolu vers le fichier JSON de la clé du compte de service
# (à NE JAMAIS committer — voir .gitignore).
GA4_PROPERTY_ID=
GA4_CREDENTIALS_PATH=

# Cloudflare Turnstile : anti-spam sur le formulaire de contact public (widget invisible
# ou léger défi, sans tracking publicitaire contrairement à reCAPTCHA). Clés à générer sur
# https://dash.cloudflare.com > Turnstile > Ajouter un site. Laisser vide désactive
# complètement l'intégration (widget non affiché, vérification serveur ignorée) — le
# formulaire reste alors protégé seulement par le honeypot/délai déjà en place.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

CACHE_DRIVER=file
SESSION_DRIVER=file
# Force le cookie de session en HTTPS uniquement (APP_ENV=production doit toujours être derrière HTTPS).
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database

LOG_CHANNEL=stack
# error en production pour éviter de journaliser des informations sensibles (debug par défaut sinon).
LOG_LEVEL=error

# Redis (optionnel)
# CACHE_DRIVER=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@votre-domaine.com
MAIL_FROM_NAME="${APP_NAME}"
