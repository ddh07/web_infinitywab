{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "test:coverage": "vitest --coverage",
        "lint": "eslint resources/js resources/css --ext .js,.vue,.css",
        "lint:fix": "eslint resources/js resources/css --ext .js,.vue,.css --fix",
        "format": "prettier --write resources/js resources/css",
        "format:check": "prettier --check resources/js resources/css",
        "type-check": "vue-tsc --noEmit",
        "audit": "npm audit --audit-level moderate",
        "ci": "npm run lint && npm run test && npm run type-check && npm run audit"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "@vitejs/plugin-vue": "^6.0.4",
        "@vue/eslint-config-prettier": "^8.0.0",
        "@vue/eslint-config-typescript": "^12.0.0",
        "@vue/test-utils": "^2.4.0",
        "autoprefixer": "^10.4.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "eslint": "^8.45.0",
        "eslint-plugin-vue": "^9.15.0",
        "jsdom": "^22.1.0",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.31",
        "prettier": "^3.0.0",
        "sass": "^1.56.1",
        "tailwindcss": "^3.4.0",
        "typescript": "^5.0.0",
        "vite": "^7.0.7",
        "vitest": "^1.0.0",
        "vue-tsc": "^1.8.0"
    },
    "dependencies": {
        "vue": "^3.5.29",
        "vue-router": "^4.6.4"
    }
}
