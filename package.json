{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "test:coverage": "vitest --coverage",
        "lint": "eslint resources/js",
        "lint:fix": "eslint resources/js --fix",
        "format": "prettier --write resources/js resources/css",
        "format:check": "prettier --check resources/js resources/css",
        "type-check": "tsc --noEmit",
        "audit": "npm audit --audit-level moderate",
        "ci": "npm run lint && npm run test && npm run type-check && npm run audit"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@typescript-eslint/eslint-plugin": "^8.64.0",
        "@typescript-eslint/parser": "^8.64.0",
        "@vue/eslint-config-prettier": "^10.2.0",
        "autoprefixer": "^10.5.4",
        "axios": "^1.18.1",
        "concurrently": "^10.0.3",
        "eslint": "^10.7.0",
        "eslint-plugin-vue": "^10.9.2",
        "globals": "^17.7.0",
        "jsdom": "^29.1.1",
        "laravel-vite-plugin": "^3.1.3",
        "postcss": "^8.5.19",
        "prettier": "^3.9.5",
        "sass": "^1.101.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "quill": "2.0.2"
    }
}
